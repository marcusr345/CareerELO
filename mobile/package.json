{
  "name": "cv-ranker-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "prebuild": "expo prebuild",
    "build:ios": "npx eas-cli build --platform ios",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
