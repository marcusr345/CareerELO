# Development can use the web dev server URL; for a physical device use your computer's LAN IP.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Configure in EAS as a public app URL before preview/production builds.
# Production builds require HTTPS and will fail if this is unset.
# EXPO_PUBLIC_WEB_URL=https://your-deployed-cv-ranker.example

# Set after creating/linking the app with EAS.
EAS_PROJECT_ID=
